{
  "name": "jandey-blog",
  "version": "1.0.0",
  "description": "Jandey Shackelford's personal website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run css:watch & bun --watch src/server.ts",
    "start": "bun run css:build && bun src/server.ts",
    "css:build": "bunx @tailwindcss/cli -i ./src/styles/globals.css -o ./public/styles.css --minify",
    "css:watch": "bunx @tailwindcss/cli -i ./src/styles/globals.css -o ./public/styles.css --watch"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.561.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5",
    "shiki": "^1.24.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
