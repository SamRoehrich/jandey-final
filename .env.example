# Tailscale Auth Key
# Generate at: https://login.tailscale.com/admin/settings/keys
# Or use OAuth client: https://login.tailscale.com/admin/settings/oauth
# 
# For OAuth client, append ?ephemeral=false to make the node persistent:
# TS_AUTHKEY=tskey-client-xxxxx?ephemeral=false
#
# For auth key with tag:
# TS_AUTHKEY=tskey-auth-xxxxx
TS_AUTHKEY=
